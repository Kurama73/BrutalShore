<Project>

  <!--
    Every external dependency is declared once here and referenced from a project without a
    version, the way the Rust workspace declared them once in [workspace.dependencies].
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="BRUTAL">
    <PackageVersion Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageVersion Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.2" />
    <PackageVersion Include="Ahwoo.BRUTAL.Logging" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
    <PackageVersion Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.ImPlot" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.Stb" Version="2026.10.3" />
    <PackageVersion Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.3" />
  </ItemGroup>

  <!--
    Audio. BRUTAL ships no sound package, so this is the one capability the game needs that the
    framework does not have. OpenAL is the choice because it is the only cross-platform audio API
    with a managed binding that ships its own native library for macOS on both architectures,
    which is where this game has to run.
  -->
  <ItemGroup Label="Audio">
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

</Project>
