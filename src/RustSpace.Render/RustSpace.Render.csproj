<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../RustSpace.Core/RustSpace.Core.csproj" />
    <ProjectReference Include="../RustSpace.Voxel/RustSpace.Voxel.csproj" />
    <ProjectReference Include="../RustSpace.World/RustSpace.World.csproj" />
    <ProjectReference Include="../RustSpace.Gpu/RustSpace.Gpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" />
  </ItemGroup>

  <!-- Shaders are compiled at startup from these files, so they have to be next to the
       executable; see ShaderLibrary for why they are text rather than build-time SPIR-V. -->
  <ItemGroup>
    <None Include="Shaders/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>

</Project>
