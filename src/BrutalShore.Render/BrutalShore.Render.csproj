<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../BrutalShore.Core/BrutalShore.Core.csproj" />
    <ProjectReference Include="../BrutalShore.Voxel/BrutalShore.Voxel.csproj" />
    <ProjectReference Include="../BrutalShore.World/BrutalShore.World.csproj" />
    <ProjectReference Include="../BrutalShore.Gpu/BrutalShore.Gpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" />
  </ItemGroup>

  <!-- Shaders are compiled at startup from these files, so they have to be next to the
       executable; see ShaderLibrary for why they are text rather than build-time SPIR-V. -->
  <ItemGroup>
    <None Include="Shaders/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Shaders" />
  </ItemGroup>

</Project>
